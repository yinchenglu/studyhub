<?xml version="1.0" encoding="utf-8"?>
<!--
  学聚 App 的 Android 清单文件。
  用法：先用 flutter create 生成骨架，再用本文件覆盖 android/app/src/main/AndroidManifest.xml
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 连接自己的 WebDAV 服务器：必需 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 播放时不熄屏 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 从相册选图上传到笔记（可选） -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 拍照插入笔记（可选） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- SOS 手电筒：控制闪光灯走的是 CameraManager.setTorchMode，需要 CAMERA 权限 -->
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- 噪声测量工具：读麦克风 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      指南针：读经纬度与海拔。
      只要「粗略位置」也能显示海拔（网络定位通常没有海拔，GPS 有），
      所以两个都声明，Dart 侧优先申请精确位置、失败就退到粗略。
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      虚拟定位工具（v1.9.0+32 新增）：让「学聚」出现在
      「开发者选项 → 选择模拟位置信息应用」的候选列表里。

      ⚠️ 这一条看着像申请权限，其实**不是** —— 它只是个「报名表」：
      ACCESS_MOCK_LOCATION 的 protectionLevel 是 signature，非系统签名的应用
      永远拿不到它。但开发者选项那个列表恰恰就是按「谁的清单里声明过这条权限」
      来筛的（AOSP 的 MockLocationAppPreferenceController 会遍历已安装应用，
      检查 requestedPermissions 里有没有它）。

      不写这一行会怎样：用户点进开发者选项，列表里**根本找不到「学聚」**，
      虚拟定位工具就永远启不起来（用户报的就是这个）。

      所以用 tools:ignore 关掉 lint 的「受保护权限」提示 —— 这行是故意写的。
      装上新包后**重新进一次开发者选项**就能看到（列表在打开那一页时重新查）。

      ⚠️ v2.0.0+34 补：release 构建会跑 `lintVitalRelease`，Lint 的 MockLocation
      检查认为这条权限只该出现在 debug 清单里，检查到就直接判死构建
      （上一次 CI 就是这样挂的，报错指向本文件第 59 行）。
      所以豁免列表里必须同时写 ProtectedPermissions 和 MockLocation 两项。
    -->
    <uses-permission
        android:name="android.permission.ACCESS_MOCK_LOCATION"
        tools:ignore="ProtectedPermissions,MockLocation" />

    <!--
      后台录音（录音录像工具）。
      WAKE_LOCK 上面已经有了；这里补前台服务相关的三条：
        FOREGROUND_SERVICE            前台服务本体
        FOREGROUND_SERVICE_MICROPHONE Android 14 起，麦克风类型的前台服务必须单独申请
      没有前台服务的话，Android 9 起后台应用拿不到麦克风 —— 一息屏录音就断。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!--
      后台录像（v1.6.0 新增）。
      这一条是 Android 14 的要求：前台服务要想「在后台继续用相机」，
      必须声明 camera 这个类型 + FOREGROUND_SERVICE_CAMERA 权限。
      （Android 9 起后台应用本来拿不到相机，唯一的正路就是这条。）
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <!--
      应用管理工具：列出手机上已安装的应用、并提取安装包。
      Android 11+ 默认只能看到一部分应用，要完整列表必须声明 QUERY_ALL_PACKAGES。
      不想用这个工具的话可以删掉这一行（工具页会提示权限不足）。
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- 下载完成提醒（可选） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      把下载的文件存到自定义目录（例如系统「下载」目录）。
      Android 11+ 需要「所有文件访问权限」；Android 10 及以下走上面已有的读写存储权限。
      权限只在第一次下载时申请；如果不想给，可以在「设置 → 下载目录」改成应用专属目录。
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:label="学聚"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true">

        <!--
          usesCleartextTraffic=true：允许用 http:// 连自建服务器（群晖 5005 端口、chfs 默认都是 http）
          如果你只用 https，可以删掉这一行。

          注意：不要在这个清单里声明任何与「原生库解压」相关的属性。
          新版 AGP 会直接报错（packageRelease 任务失败），要求改由 Gradle 脚本设置
          jniLibs.useLegacyPackaging = true —— media_kit 的 libmpv 需要解压到文件系统才能加载。
          该设置已由工作流 / README 中的构建步骤写入 android/app/build.gradle.kts。
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!--
          后台录音服务。
          注意名字里的 `$`：RecorderService 是 MainActivity 的嵌套类
          （Kotlin 嵌套类相当于 Java 的 static nested class，框架能反射实例化）。
          这么写是为了让云端构建只需要注入 MainActivity.kt 这一个文件，
          不用再改工作流去拷第二个 .kt。
          foregroundServiceType="microphone" 是 Android 14 的硬要求。
        -->
        <service
            android:name=".MainActivity$RecorderService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!--
          后台录像服务（v1.6.0 新增）。
          `camera|microphone` 两个类型都要：相机是「退到后台继续录」的关键，
          麦克风是因为录的时候要带声音。运行时按实际选项挑（见 VideoRecorderService）。

          ⚠️ 这里必须写 `|` 而不是只写 camera —— 少写一个类型时，
          startForeground() 里传的类型只要不在清单里，Android 14 会直接抛
          SecurityException。反过来多写一个不影响。
        -->
        <service
            android:name=".MainActivity$VideoRecorderService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- 快递查询等工具要用浏览器打开 https 页面（Android 11+ 需要声明可见性） -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>
</manifest>
